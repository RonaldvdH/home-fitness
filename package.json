{
  "name": "home-fitness",
  "version": "1.0.0",
  "private": true,
  "description": "Dumbbell Circuit Studio — Offline-First Home Workout Trainer with 60 FPS SVG Kinematics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm build && pnpm check:budget"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "preact": "^11.2.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.11",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^7.0.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
